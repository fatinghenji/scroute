#!/usr/bin/env bash
# scroute — 星际公民货运路线速查（零 LLM token，直接跑 UEX 数据）
#
# 用法:
#   scroute                          # Railen+700W 全局 Top 路线
#   scroute from "Patch City"        # 去程：从某站出发买什么
#   scroute to "Patch City"          # 返程：买什么回某站卖
#   scroute loop "Patch City"        # 环形：去程+返程一次出（仅 UEX）
#   scroute dual "Patch City"        # 双源核验：UEX + SC Trade Tools 四段对照（2026-08-12）
#   scroute fresh ...                # 任意子命令前加 fresh = 强制刷新库存
#   scroute --ship "Hull B" --capital 5000000 from Baijini   # 覆盖默认船/本金
#   scroute raw <原样参数...>         # 透传给 plan_route.py
#
# 数据: UEX API 2.0 众包价，服务端缓存 ~30 分钟。脚本缓存在 /tmp/uex_cache（25 分钟）。
# fresh 只刷第一段：loop/dual 的后几段直接复用第一段写好的缓存，避免重复清缓存重拉。
# 网络: 直连超时/限速自动回退代理（UEX_PROXY/https_proxy 指定，默认 http://127.0.0.1:43010）。

# 解析真实路径（兼容 macOS BSD：readlink 无 -f，改用 python realpath）
SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
SCRIPT="$(dirname "$SELF")/plan_route.py"
SCTT="$(dirname "$SELF")/sctt_routes.py"

usage() {
  cat <<'EOF'
scroute — 星际公民货运路线速查（零 LLM token，直接跑 UEX 数据）

用法:
  scroute                            # 全局 Top 15 路线（默认 Railen + 700W）
  scroute from "Patch City"          # 去程：从该站出发买什么、卖到哪
  scroute to "Patch City"            # 返程：半路买什么带回该站卖
  scroute loop "Patch City"          # 环形：去程+返程一次出
  scroute dual "Patch City"          # 双源核验：UEX + SC Trade Tools 四段对照
                                     #   （去程/返程 × UEX/SCTT 各一段，交叉验证）
  scroute dual                       # 双源核验：不指定站 = 全局对照（Top 15）
  scroute fresh <子命令>             # 强制刷新库存再跑（出发前必用；--refresh 同义）

覆盖参数（可加在子命令前后）:
  --ship "Hull B"      换船（默认 Railen；UEX 按船名自动取舱容）
  --capital 5000000    换本金 aUEC（默认 700W = 7000000）
  --min-roi 30         最低 ROI%（默认 25）
  --min-profit 1000000 最低绝对利润 aUEC（默认 0 = 不过滤）
  --top 20             输出条数（默认 15）
  --full               满仓押全部本金（默认只押一半，留一半防意外）

其他:
  scroute raw <参数...>   直接透传底层 plan_route.py
                          （scroute raw --help 看全部底层参数）
  scroute dual 需 pycryptodome 包：pip install pycryptodome

数据: UEX API 2.0 众包价，服务端缓存 ~30 分钟；脚本缓存在 /tmp/uex_cache（25 分钟）。
网络: 直连超时/限速自动回退本机代理（UEX_PROXY/https_proxy 指定，默认 http://127.0.0.1:43010）。
EOF
}

SHIP="Railen"
CAPITAL=7000000
MIN_ROI=25
MIN_PROFIT=0
TOP=15
FRESH=0
MODE=""
PLACE=""
EXTRA=()

while [[ $# -gt 0 ]]; do
  # 子命令已设但站名未取到：下一个非选项裸词就是站名
  # （支持 `dual --capital 9000000` 无站名全局、`from --space-only Baijini` 选项夹中间等任意顺序）
  if [[ -n "$MODE" && -z "$PLACE" && "$1" != -* && "$1" != "fresh" && "$1" != "raw" ]]; then
    PLACE="$1"; shift; continue
  fi
  case "$1" in
    from|to|loop|dual)
      case "$1" in
        from) MODE="--origin" ;;
        to)   MODE="--dest" ;;
        *)    MODE="$1" ;;
      esac
      # 子命令后紧跟的裸词 = 站名；是选项则跳过（站名槽位留空 = 全局，或由上面的检查补取）
      if [[ -n "$2" && "$2" != -* && "$2" != "fresh" && "$2" != "raw" ]]; then
        PLACE="$2"; shift 2
      else
        shift 1
      fi ;;
    fresh)  FRESH=1; shift ;;
    --refresh) FRESH=1; shift ;;   # 与 fresh 等价（--refresh 不再只透传 UEX 段）
    --ship) SHIP="$2"; shift 2 ;;
    --capital) CAPITAL="$2"; shift 2 ;;
    --min-roi) MIN_ROI="$2"; shift 2 ;;
    --min-profit) MIN_PROFIT="$2"; shift 2 ;;
    --top) TOP="$2"; shift 2 ;;
    raw) shift; exec python3 "$SCRIPT" "$@" ;;
    -h|--help) usage; exit 0 ;;
    *) EXTRA+=("$1"); shift ;;
  esac
done

run() {
  local -a args=(--ship "$SHIP" --capital "$CAPITAL" --min-roi "$MIN_ROI" --min-profit "$MIN_PROFIT" --top "$TOP")
  if (( FRESH )); then
    args+=(--refresh)
    FRESH=0   # 同一次运行只刷第一段，后续段复用缓存
  fi
  python3 "$SCRIPT" "${args[@]}" "$@" "${EXTRA[@]}"
}

if [[ "$MODE" == "dual" ]]; then
  if ! python3 -c "import Crypto" >/dev/null 2>&1; then
    echo "dual 需要 pycryptodome 包（SC Trade Tools 双源段用）：pip install pycryptodome" >&2
    exit 1
  fi
  # SCTT 与 UEX 本金口径对齐：UEX 默认半仓，SCTT 也按半仓；用户显式 --full 时两边都全押
  INV="$CAPITAL"
  if [[ " ${EXTRA[*]:-} " != *" --full "* ]]; then
    INV=$((CAPITAL / 2))
  fi
  sctt_args=(--ship "$SHIP" --investment "$INV" --top "$TOP")
  sctt_fresh=0
  (( FRESH )) && sctt_fresh=1   # SCTT 缓存键只含 ship|investment，第一段刷一次即可
  if [[ -n "$PLACE" ]]; then
    leg_out=(--origin "$PLACE"); leg_back=(--dest "$PLACE")
    tag_out="：从 $PLACE 出发"; tag_back="：回 $PLACE 卖"
  else
    leg_out=(); leg_back=()
    tag_out="（全局 Top $TOP）"; tag_back="（全局 Top $TOP）"
  fi
  echo "════════ 去程 UEX${tag_out} ════════"
  run "${leg_out[@]}"
  echo
  echo "════════ 去程 SCTT（双源比对） ════════"
  if (( sctt_fresh )); then
    python3 "$SCTT" "${sctt_args[@]}" --refresh "${leg_out[@]}"
  else
    python3 "$SCTT" "${sctt_args[@]}" "${leg_out[@]}"
  fi
  echo
  echo "════════ 返程 UEX${tag_back} ════════"
  run "${leg_back[@]}"
  echo
  echo "════════ 返程 SCTT（双源比对） ════════"
  python3 "$SCTT" "${sctt_args[@]}" "${leg_back[@]}"
elif [[ "$MODE" == "loop" ]]; then
  if [[ -n "$PLACE" ]]; then
    leg_out=(--origin "$PLACE"); leg_back=(--dest "$PLACE")
    tag_out="：从 $PLACE 出发"; tag_back="：回 $PLACE 卖"
  else
    leg_out=(); leg_back=()
    tag_out="（全局）"; tag_back="（全局）"
  fi
  echo "════════ 去程${tag_out} ════════"
  run "${leg_out[@]}"
  echo
  echo "════════ 返程${tag_back} ════════"
  run "${leg_back[@]}"
elif [[ -n "$MODE" ]]; then
  if [[ -n "$PLACE" ]]; then
    run "$MODE" "$PLACE"
  else
    run
  fi
else
  run
fi
